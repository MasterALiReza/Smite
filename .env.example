# Smite Panel Configuration
# Copy this file to .env and update with your values

# Panel Settings
PANEL_HOST=0.0.0.0
PANEL_PORT=8000
PANEL_DOMAIN=
HTTPS_ENABLED=false
HTTPS_CERT_PATH=./certs/server.crt
HTTPS_KEY_PATH=./certs/server.key
# Swagger/OpenAPI docs are disabled by default in production for security.
# Set DOCS_ENABLED=true only if you need /docs.
DOCS_ENABLED=false
# Comma-separated list of allowed CORS origins. Use "*" for development only.
CORS_ORIGINS=*

# Database Settings
DB_TYPE=sqlite
DB_PATH=./data/smite.db
# NOTE: Only SQLite is supported. The host/port/name/user fields below are unused.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=smite
# DB_USER=smite
# DB_PASSWORD=changeme

# Node Communication Settings
NODE_PORT=4443
NODE_CERT_PATH=./certs/ca.crt
NODE_KEY_PATH=./certs/ca.key
# Separate CA cert for foreign servers
NODE_SERVER_CERT_PATH=./certs/ca-server.crt
NODE_SERVER_KEY_PATH=./certs/ca-server.key

# Optional shared secret for panel<->node agent API authentication.
# Set the SAME value on both the panel and each node (NODE_API_TOKEN).
# When set, all agent API requests require the X-Node-Token header.
# Leave empty for backward compatibility with older deployments.
NODE_API_TOKEN=

# Comma-separated list of addresses the panel treats as "local/collocated"
# when routing node communication. Add your own collocated server IPs here
# (never commit real IPs to the repository).
PANEL_LOCAL_IPS=127.0.0.1,localhost,::1

# Security
# IMPORTANT: Set a strong random secret (e.g. `openssl rand -hex 32`).
# The default below is a known weak value — the panel logs a critical
# warning while it is in use.
SECRET_KEY=changeme-secret-key-change-in-production

# Nginx Settings (for HTTPS profile)
SMITE_HTTP_PORT=80
SMITE_HTTPS_PORT=443
SMITE_SSL_DOMAIN=REPLACE_DOMAIN

# Version
SMITE_VERSION=latest
